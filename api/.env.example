# Local development values. In production these come from the Render service's
# environment variables — see docs/ARCHITECTURE.md § Deployment, which also explains why the
# API has to sit on a subdomain of the web domain for sessions to work.

# On Render, the Postgres instance's Internal Database URL.
# Matches the db service in docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://uofthub:uofthub@localhost:5433/uofthub"
# Required in production: the API refuses to boot without it rather than
# signing sessions anyone could forge.
JWT_SECRET="change-me-in-production"
# Render provides PORT; the server binds 0.0.0.0.
PORT=3001
# Proxies in front of the API. Defaults to 1 in production (Render's) and 0
# otherwise; see docs/ARCHITECTURE.md § Deployment.
# TRUST_PROXY_HOPS=1

# Microsoft Entra ID (Azure AD) OAuth — optional locally; without it, sign in
# with email + password. Azure Portal → App registrations → your app → Overview
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/auth/callback"

# Authority segment, NOT necessarily your own tenant's GUID.
#   organizations - any work/school tenant (required to accept utoronto.ca
#                   accounts; the app registration must also be set to
#                   "Accounts in any organizational directory")
#   <tenant guid> - only users homed in that one tenant
# Defaults to "organizations" when unset.
MICROSOFT_TENANT_ID="organizations"

# The directory (tenant) ids whose accounts may sign in, comma separated —
# U of T's. Required in production: under "organizations" any directory can
# claim any address, so without this every Microsoft sign-in is refused (see
# src/lib/microsoftTenant.ts). Find it by signing in once and reading the
# "tid" in the API's warning log, or on the Entra admin centre's Overview.
# Locally, unset allows any tenant.
MICROSOFT_ALLOWED_TENANT_IDS=""

WEB_URL="http://localhost:5173"

# This API's own public base URL — used to build stable links back to it,
# e.g. GET /users/:id/avatar (see api/src/lib/avatar.ts). Change this to
# the real API domain in production.
API_URL="http://localhost:3001"

# File storage (S3-compatible). Locally this is the S3Mock service in
# docker-compose.yml, which works as-is. In production it is Cloudflare R2:
# set STORAGE_ENDPOINT to https://<ACCOUNT_ID>.r2.cloudflarestorage.com, use an
# R2 API token's keys, and drop STORAGE_FORCE_PATH_STYLE.
STORAGE_BUCKET="uofthub-files"
STORAGE_REGION="auto"
STORAGE_ENDPOINT="http://localhost:9090"
STORAGE_ACCESS_KEY="local"
STORAGE_SECRET_KEY="local"
STORAGE_FORCE_PATH_STYLE="true"

# Resend (email transport). Sending is disabled — with a console warning —
# when this is unset, so it's safe to leave blank in local dev: the sign-up
# confirmation and password reset links are printed to the API's console
# instead. Required in production, or nobody can confirm a password sign-up.
RESEND_API_KEY=""
# The notifications. subdomain keeps sending reputation apart from hello@uofthub.com;
# verify it (SPF, DKIM, DMARC) under Domains in Resend.
EMAIL_FROM="uofthub <notifications@notifications.uofthub.com>"

# Web Push (push notifications from /settings). Unset disables push, with a
# console warning. Generate once with `npx web-push generate-vapid-keys`;
# changing them later invalidates every browser's subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@uofthub.com"

# OpenAI (natural-language search on /discover, and filling in the post form
# from an imported link). Unset means /discover falls back to a plain keyword
# search and link import to the page's own metadata, with a console warning —
# safe to leave blank locally and in any deploy without an AI budget.
OPENAI_API_KEY=""

# Model used for both. Optional: unset uses the default compiled into
# lib/openai.ts (gpt-5.6-luna). Set it to pin a different
# model per deployment without a code change.
OPENAI_MODEL=""

# Ceilings on link-import AI calls, per UTC day. Past either, imports are the
# plain metadata-only kind. A link is paid for once a day however many paste it.
AI_IMPORT_PER_STUDENT_DAY="5"
AI_IMPORT_PER_DAY="200"
