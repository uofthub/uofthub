{
  "name": "@uofthub/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "predev": "prisma migrate deploy && prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grant-admin": "tsx src/scripts/grantAdmin.ts",
    "grant-admin:prod": "node dist/scripts/grantAdmin.js",
    "og:site": "tsx src/scripts/renderSiteCard.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/oauth2": "^8.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.20.0",
    "@resvg/resvg-js": "^2.6.2",
    "@uofthub/types": "workspace:*",
    "fastify": "^5.0.0",
    "file-type": "^22.0.2",
    "openai": "^7.8.0",
    "pg": "^8.23.0",
    "resend": "^6.24.0",
    "satori": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
