generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can open a project:
///   PRIVATE  — a draft: the owner and accepted collaborators
///   UOFT     — any signed-in U of T account
///   PUBLIC   — anyone, and it is listed everywhere
///   UNLISTED — anyone with the link, but never listed, searched or fanned out
enum Visibility {
  PRIVATE
  UOFT
  PUBLIC
  UNLISTED
}

/// What kind of work a project is. Decides a card's badge and main action,
/// and which questions the post form asks. Null for projects from before it
/// existed.
enum ProjectType {
  APP
  RESEARCH
  FILM
  DESIGN
  AUDIO
  HARDWARE
  WRITING
  OTHER
}

/// Where a project stands. HELP_WANTED is what the "Looking for help" feed
/// and Explore's toggle filter on.
enum ProjectStatus {
  IN_PROGRESS
  SHIPPED
  HELP_WANTED
}

enum CollaboratorRole {
  OWNER
  COLLABORATOR
  VIEWER
}

/// The three U of T campuses. Nullable wherever it appears: campus was added
/// after launch so existing rows have none, and nothing obliges a student to
/// say which one they are at.
enum Campus {
  UTSG
  UTM
  UTSC
}

enum OrgType {
  CLUB
  LAB
}

/// Where a person stands with a group. Only ACTIVE members are members:
/// INVITED is waiting on the person, REQUESTED on the group's admins.
enum OrgMemberStatus {
  ACTIVE
  INVITED
  REQUESTED
}

/// The first five are administrative — something happened that the student has
/// to answer or is obliged to know. The rest are social: somebody engaged with
/// their work, or somebody they follow published. Without those the site asks
/// students to publish into a void, since a like or a comment was previously
/// only discoverable by reopening the project and reading a counter.
enum NotificationType {
  COLLABORATOR_INVITED
  COLLABORATOR_RESPONDED
  ACCESS_REQUESTED
  ACCESS_REQUEST_DECIDED
  PROJECT_MODERATED
  PROJECT_LIKED
  PROJECT_COMMENTED
  PROJECT_REACTED
  FOLLOWED_YOU
  FOLLOWING_PUBLISHED
  /// "Want to collab" — sent privately to the owner, once per person per
  /// project. The public reaction count says how many; only this says who.
  PROJECT_COLLAB_INTEREST
  /// Somebody replied to your comment.
  COMMENT_REPLIED
  /// A moderator warned you, or suspended your messaging, after a
  /// conversation was reported.
  MESSAGING_MODERATED
  /// A project you follow posted an update (a version with a note).
  PROJECT_UPDATED
  /// A moderator warned you about, or removed, something you posted that is
  /// not a project — a comment, a collection, a group event, your profile.
  CONTENT_MODERATED
  /// A moderator suspended your account, or lifted the suspension.
  ACCOUNT_MODERATED
  /// A group's admin invited you to join it.
  ORG_INVITED
  /// Somebody asked to join a group you run.
  ORG_JOIN_REQUESTED
  /// Your request to join a group was approved, or your invitation answered.
  ORG_MEMBERSHIP_DECIDED
}

/// What a report is about.
enum ReportTarget {
  PROJECT
  COMMENT
  COLLECTION
  USER
  ORG_ACTIVITY
}

/// The three reactions on a project — the app's only public engagement
/// signal (likes were folded into IMPRESSIVE; see the engagement migration).
///   IMPRESSIVE — "Impressive"
///   USEFUL     — shown as "Learned something"
///   COLLAB     — "Want to collab": counted publicly, but who reacted is only
///                ever shown to the owner, with a private notification
enum ReactionKind {
  USEFUL
  IMPRESSIVE
  COLLAB
}

/// What a project drew on. Decides the icon and the "also used in…" wording.
enum ReferenceKind {
  DATASET
  PAPER
  SOFTWARE
  MODEL
  BOOK
  ARCHIVE
  WEBSITE
  OTHER
}

/// What an output is. Decides its label ("View poster") and icon.
enum OutputKind {
  POSTER
  SLIDES
  PAPER
  VIDEO
  AUDIO
  DEMO
  CODE
  DATASET
  OTHER
}

enum ReportReason {
  SPAM
  HARASSMENT
  ACADEMIC_INTEGRITY
  INTELLECTUAL_PROPERTY
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  WARNED
  TAKEN_DOWN
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  /// scrypt hash; null for accounts that only ever signed in with Microsoft.
  passwordHash         String?
  /// When the student proved they own `email` — by signing in with Microsoft
  /// or by following the link we emailed. Null for an email + password
  /// sign-up nobody has confirmed yet: such an account cannot sign in, and is
  /// nobody's until it is confirmed (see routes/auth.ts).
  emailVerifiedAt      DateTime?
  /// Carried in every session token as `sv`. Bumping it signs the account out
  /// everywhere — a password change or reset, or "sign out everywhere".
  sessionVersion       Int       @default(0)
  faculty              String?
  campus               Campus?
  program              String?
  classYear            Int?
  avatarUrl            String?
  /// R2 object key when the avatar lives in our bucket; null for no avatar or
  /// an externally-pasted URL. Fixed per user (`avatars/<id>`) — a new
  /// upload/sync always overwrites the previous one.
  avatarKey            String?
  /// True once the student has set their own avatar (upload or manual URL) —
  /// the Microsoft sign-in avatar sync only ever fires for a brand new
  /// account, so it never overwrites this.
  avatarIsCustom       Boolean   @default(false)
  bio                  String?
  /// What the student is looking for — "Collaboration", "Summer 2027
  /// internships". Free text, a handful of short items; the profile's
  /// "Open to" chips.
  openTo               String[]  @default([])
  /// Personal links on the profile. http(s) only, checked by safeExternalUrl.
  websiteUrl           String?
  githubUrl            String?
  linkedinUrl          String?
  /// Course codes the student says they take (CSC343, MAT137). Adds to the
  /// courses inferred from their own projects' tags — see routes/feed.ts.
  courses              String[]  @default([])
  /// Whether other students may start a conversation with them. Replies in an
  /// existing conversation are unaffected by turning this off.
  allowMessages        Boolean   @default(true)
  /// Whether things that need an answer (invitations, access requests,
  /// moderation decisions, a new conversation) are also emailed. Off leaves
  /// the in-app bell as the only channel.
  emailNotifications   Boolean   @default(true)
  /// Set by a moderator deciding a message report; while set, the student can
  /// read their conversations but not send. Cleared to lift it.
  messagingSuspendedAt DateTime?
  /// Set by a moderator to suspend the whole account: the student can still
  /// sign in, read, and delete or export their own things, but can't post,
  /// comment, react, follow or message. Cleared to lift it. See lib/session.ts.
  suspendedAt          DateTime?
  /// Platform moderator. Set directly in the database (see
  /// `pnpm --filter @uofthub/api grant-admin <email>`) — nothing in the app
  /// grants it, so it can't be escalated to through the API.
  isAdmin              Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  ownedProjects          Project[]             @relation("ProjectOwner")
  collaborations         ProjectCollaborator[]
  reactions              ProjectReaction[]
  saves                  ProjectSave[]
  comments               Comment[]
  helpful                CommentHelpful[]
  spotlightPicks         Spotlight[]           @relation("SpotlightPicks")
  following              Follow[]              @relation("Following")
  followers              Follow[]              @relation("Followers")
  orgMemberships         OrgMember[]
  notifications          Notification[]
  reportsFiled           Report[]              @relation("Reporter")
  reportsReviewed        Report[]              @relation("Reviewer")
  reportsAbout           Report[]              @relation("ReportSubject")
  orgActivities          OrgActivity[]
  projectFollows         ProjectFollow[]
  collections            Collection[]
  sentMessages           Message[]             @relation("SentMessages")
  receivedMessages       Message[]             @relation("ReceivedMessages")
  blocking               UserBlock[]           @relation("Blocking")
  blockedBy              UserBlock[]           @relation("BlockedBy")
  messageReportsFiled    MessageReport[]       @relation("MessageReporter")
  messageReportsAgainst  MessageReport[]       @relation("MessageReported")
  messageReportsReviewed MessageReport[]       @relation("MessageReviewer")
  authTokens             AuthToken[]
  emailInvitesSent       ProjectEmailInvite[]  @relation("EmailInvitesSent")
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// A single-use link we emailed: confirming an address, or setting a new
/// password. Only a SHA-256 of the token is stored, so a copy of this table
/// cannot be turned into working links.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Project {
  id              String         @id @default(uuid())
  ownerId         String
  title           String
  /// The one line a card shows. Separate from the description (the story) so
  /// a card never has to guess where one ends — see the project_fields
  /// migration for how existing descriptions were split.
  pitch           String?
  description     String?
  /// Optional sections beyond the overview (motivation, method, results…) —
  /// an ordered JSON list validated and stripped of empties by
  /// lib/projectContent.ts. Null when there are none.
  sections        Json?
  /// Short labelled facts (Supervisor, Runtime, Performers) as an ordered
  /// `[{ label, value }]` list. Null when there are none.
  details         Json?
  type            ProjectType?
  status          ProjectStatus?
  tags            String[]       @default([])
  /// The course it was made for, upper-cased: CSC211H5. The one source of
  /// truth for "Built for" and Explore's course filter — see the
  /// `course_code` migration, which moved it out of the tags.
  courseCode      String?
  /// The course template the project was started from (lib/courseTemplates.ts)
  /// and that template's version at the time.
  templateCode    String?
  templateVersion Int?
  visibility      Visibility     @default(PRIVATE)
  viewCount       Int            @default(0)
  /// When the project first stopped being PRIVATE. Distinct from createdAt: a
  /// capstone drafted in January and published in March belongs in March's
  /// feed, not January's. Null while it has never been visible to anyone but
  /// the owner, which is also what stops the follower fan-out firing twice on
  /// a project that is toggled UOFT → PRIVATE → UOFT.
  publishedAt     DateTime?
  /// Until this moment only the owner and accepted collaborators can see the
  /// project, whatever its visibility — course work stays hidden until after
  /// grading. Enforced in lib/visibility.ts and nowhere else. Null for most
  /// projects, which show as soon as their visibility allows.
  showFrom        DateTime?
  /// When the owner's followers were told about it. Separate from publishedAt
  /// because a project with a future show-from date is published (publishedAt
  /// is set to that date, so it enters feeds when it appears) long before it
  /// can be announced — see lib/announcements.ts.
  announcedAt     DateTime?
  /// Set while the owner has pinned this to the top of their profile. Pinned
  /// projects are the only ones a profile renders as cards — see
  /// docs/feed-and-density.md for why everything else is a list.
  pinnedAt        DateTime?
  /// Set when a moderator takes the project down: visibility is forced back to
  /// PRIVATE and the owner cannot re-open it while this is set. Null for every
  /// project that has never been actioned.
  takenDownAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  /// Postgres-generated tsvector over title, course, pitch, tags,
  /// description, sections and details — see the `course_code` migration for
  /// the current expression. Declared
  /// `Unsupported` because Prisma has no tsvector type: nothing reads it
  /// through the client, only `lib/search.ts` via raw SQL.
  searchVector Unsupported("tsvector")?

  /// Deleting an account deletes the projects it owns (see DELETE /users/me).
  owner           User                  @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators   ProjectCollaborator[]
  files           ProjectFile[]
  links           ProjectLink[]
  references      ProjectReference[]
  outputs         ProjectOutput[]
  reactions       ProjectReaction[]
  saves           ProjectSave[]
  comments        Comment[]
  versions        ProjectVersion[]
  dailyViews      ProjectDailyView[]
  viewers         ProjectViewer[]
  spotlights      Spotlight[]
  orgProjects     OrgProject[]
  reports         Report[]
  followers       ProjectFollow[]
  collectionItems CollectionItem[]
  emailInvites    ProjectEmailInvite[]

  /// The directory's default read: visible projects, newest first.
  @@index([visibility, createdAt])
  /// A profile's project list, and the owner check in visibleProjectWhere.
  @@index([ownerId, createdAt])
  /// Owner-only lifetime total; trending is computed from the last 7 days.
  @@index([viewCount])
  /// The looking-for-help feed and Explore's type/status filters.
  @@index([status])
  @@index([type])
  /// The home feed's ordering — see routes/feed.ts.
  @@index([publishedAt])
  /// A profile's pinned strip: six rows out of however many the student owns.
  @@index([ownerId, pinnedAt])
  /// The announcement sweep: hidden projects whose show-from date has passed.
  @@index([showFrom])
  /// Explore's course filter and a course's facet count.
  @@index([courseCode])
  @@index([searchVector], type: Gin)
}

model Report {
  id           String       @id @default(uuid())
  reporterId   String
  targetType   ReportTarget @default(PROJECT)
  /// The project reported, or the project a reported comment is on.
  projectId    String?
  commentId    String?
  collectionId String?
  activityId   String?
  /// Whoever posted what is reported — the one a warning or a suspension is
  /// for. For a reported profile, that person.
  subjectUserId String?
  /// What was reported, as it read when it was reported — a comment or an
  /// event can be edited or deleted before a moderator gets to it.
  excerpt      String?
  reason       ReportReason
  /// Optional free text from the reporter — the reason enum is what the queue
  /// sorts on, this is the context a moderator actually needs to decide.
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  /// Set together when a moderator decides the report.
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("Reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  collection Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  activity   OrgActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  subject    User?        @relation("ReportSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, status])
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  versionNum  Int
  /// The release note — what changed. It is what the Updates timeline shows.
  note        String?
  title       String
  description String?
  sections    Json?
  details     Json?
  tags        String[] @default([])
  courseCode  String?
  /// The references as they stood: kind, title, url, doi, authors, year, note.
  references  Json?
  /// The outputs as they stood, each naming its file or link rather than
  /// pointing at it — a file deleted since still shows what it was.
  outputs     Json?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNum])
}

model ProjectDailyView {
  projectId String
  date      DateTime @db.Date
  count     Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date])
  @@index([projectId, date])
}

/// Who has already been counted as a view of a project today. A view is one
/// person once a day — a signed-in user by id, anyone else by a salted hash of
/// their address and browser — so refreshes, refetches and crawlers repeating
/// themselves stop inflating the number. Only today's rows matter; older ones
/// are pruned as each project's first view of a new day comes in.
model ProjectViewer {
  projectId String
  date      DateTime @db.Date
  viewerKey String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date, viewerKey])
}

/// The home feed's weekly spotlight, picked by a moderator. One per week; the
/// week is the Monday it starts on (UTC).
model Spotlight {
  id         String   @id @default(uuid())
  projectId  String
  weekOf     DateTime @unique @db.Date
  /// Optional line shown under the title — why it was picked.
  note       String?
  /// The moderator who picked it; kept as history if their account goes.
  pickedById String?
  createdAt  DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pickedBy User?   @relation("SpotlightPicks", fields: [pickedById], references: [id], onDelete: SetNull)
}

model ProjectCollaborator {
  projectId String
  userId    String
  role      CollaboratorRole @default(COLLABORATOR)
  /// What they did, as the owner put it when inviting them: "Designer",
  /// "Data analysis". Shown beside their name. Null for plain "Collaborator".
  title     String?
  /// False while an invitation (or a TA's access request) is waiting for an
  /// answer. A declined invitation or a denied request is deleted, never left
  /// behind as `false`.
  accepted  Boolean          @default(false)
  invitedAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  /// visibleProjectWhere runs `collaborators.some({ userId })` on every list
  /// query; the @@id above leads with projectId and cannot serve it.
  @@index([userId])
}

/// An invitation to collaborate sent to an address with no account yet. It
/// becomes an ordinary pending collaborator invitation the moment an account
/// with that address is confirmed (lib/accounts.ts).
model ProjectEmailInvite {
  projectId   String
  /// Lower-cased, and always a U of T address.
  email       String
  title       String?
  invitedById String
  invitedAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("EmailInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([projectId, email])
  @@index([email])
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  /// R2 object key, not a public URL — downloads go through a signed URL so
  /// they still honour project visibility.
  storageKey String
  sizeBytes  Int
  mimeType   String?
  uploadedAt DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output  ProjectOutput?

  /// Cover lookups, per-project file lists and the file-count cap.
  @@index([projectId])
}

/// A dataset, paper, piece of software, model, book or archive the project
/// used. Replaced as a whole list whenever the project is saved with one.
model ProjectReference {
  id        String        @id @default(uuid())
  projectId String
  kind      ReferenceKind
  title     String
  /// http(s) only, checked by safeExternalUrl.
  url       String?
  /// Bare and lower-cased: 10.1000/xyz.
  doi       String?
  authors   String?
  year      Int?
  /// "Used the 2019 split", "baseline only".
  note      String?
  /// Normalized identity — doi:…, arxiv:…, github:owner/repo, hf:…, kaggle:…
  /// or a canonical URL — so two projects citing the same thing match however
  /// they pasted it. Null with neither a URL nor a DOI. See lib/references.ts.
  key       String?
  position  Int

  /// Generated over title and authors; see the `references` migration.
  searchVector Unsupported("tsvector")?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  /// "Also used in…": other projects with the same key.
  @@index([key])
  @@index([searchVector], type: Gin)
}

model ProjectLink {
  id        String @id @default(uuid())
  projectId String
  label     String
  url       String

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  output  ProjectOutput?
}

/// What a project produced, in the author's order: an ordered layer over its
/// files and links. Exactly one of `fileId` and `linkId` is set (a CHECK in
/// the `outputs` migration), and deleting the target deletes the output.
model ProjectOutput {
  id                 String     @id @default(uuid())
  projectId          String
  kind               OutputKind
  /// Overrides the kind's label: "Final poster".
  label              String?
  fileId             String?    @unique
  linkId             String?    @unique
  position           Int
  /// The project's id on its primary output, null on every other one. Unique,
  /// so a project has at most one primary; a CHECK in the migration keeps it
  /// equal to `projectId`. The primary output's thumbnail is the project's
  /// image everywhere — see lib/covers.ts.
  primaryOfProjectId String?    @unique
  /// R2 key of a thumbnail made in the author's browser (a poster's first
  /// page, a video frame, a large image scaled down) or chosen by hand. Null
  /// when there is none; a small image is its own thumbnail.
  thumbnailKey       String?

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file    ProjectFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  link    ProjectLink? @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

/// A private bookmark. Unlike a reaction it is never shown to anyone but the
/// person who saved it, and never notifies the owner.
model ProjectSave {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Leads with userId: the only bulk read is "my saved projects".
  @@id([userId, projectId])
  @@index([projectId])
}

/// One reaction of one kind by one person. Separate rows rather than a single
/// row with flags, so a student can say a project is both useful and well
/// documented without the two answers overwriting each other.
model ProjectReaction {
  projectId String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Leads with projectId, which is what the per-project tally groups by — no
  /// secondary index is needed on top of it.
  @@id([projectId, userId, kind])
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  /// Set on a reply. One level only: a reply to a reply is filed under the
  /// same top-level comment (see POST /projects/:id/comments).
  parentId  String?
  body      String
  createdAt DateTime @default(now())
  /// Set when its author edits it; the thread says "edited".
  editedAt  DateTime?
  /// Set when a comment that has replies is deleted: its text is cleared and
  /// it stays as "deleted" so the replies keep their thread. A comment with
  /// no replies is deleted outright.
  deletedAt DateTime?

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]        @relation("CommentReplies")
  helpful CommentHelpful[]
  reports Report[]

  @@index([projectId, createdAt])
  @@index([parentId])
}

/// "Helpful" on a comment. Helpful comments are listed first.
model CommentHelpful {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  /// Follower counts read by followingId — the @@id leads with followerId.
  @@index([followingId])
}

model Organization {
  id                   String    @id @default(uuid())
  slug                 String    @unique
  name                 String
  type                 OrgType   @default(CLUB)
  /// The campus the group is based at. A club can serve all three, which is
  /// what null means here — not "unknown".
  campus               Campus?
  description          String?
  websiteUrl           String?
  /// Invite link to the group's Discord server. Validated as a discord.gg /
  /// discord.com URL, not just any http(s) one.
  discordUrl           String?
  /// Share link to the group's GroupMe. Same treatment as discordUrl.
  groupMeUrl           String?
  /// How moderators reach the group's exec — set when a moderator creates the
  /// page, and shown only to the group's own members.
  contactEmail         String?
  /// The exec's role, e.g. "president", "lab manager".
  contactRole          String?
  createdAt            DateTime  @default(now())

  members    OrgMember[]
  projects   OrgProject[]
  activities OrgActivity[]
}

/// A meeting, event, workshop or recap — lighter than a Project, and only
/// ever rendered on the group's own page.
model OrgActivity {
  id          String   @id @default(uuid())
  orgId       String
  createdById String
  title       String
  description String?
  date        DateTime
  link        String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([orgId, date])
}

model OrgMember {
  orgId    String
  userId   String
  /// MEMBER or ADMIN. Admins edit the page and manage its members.
  role     String          @default("MEMBER")
  status   OrgMemberStatus @default(ACTIVE)
  joinedAt DateTime        @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  /// Denormalized display data (project title, actor name, etc.) captured at
  /// creation time, so the feed still reads correctly after the source row
  /// changes or is deleted.
  payload   Json
  /// Identity of the thing being announced, for the notifications that must
  /// only ever fire once — `like:<projectId>:<actorId>`, `follow:<actorId>`.
  /// Without it, un-liking and re-liking a project is an unlimited way to ping
  /// its owner. Null for the announcements that are genuinely new every time
  /// (each comment).
  key       String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  /// The `notifyOnce` existence check.
  @@index([userId, type, key])
}

model OrgProject {
  orgId     String
  projectId String

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([orgId, projectId])
}

/// "Follow updates" on a project: told when the owner posts an update. Private
/// to the follower, like a save; the owner sees only a count.
model ProjectFollow {
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  /// The fan-out on a new update reads by project.
  @@index([projectId])
}

/// A hand-picked set of projects with a curator ("Best of UTM 2026"). Anyone
/// may read one; each reader only sees the projects they could see anyway.
model Collection {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items   CollectionItem[]
  reports Report[]

  @@index([ownerId, updatedAt])
  @@index([updatedAt])
}

model CollectionItem {
  collectionId String
  projectId    String
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([collectionId, projectId])
  @@index([projectId])
}

/// One direct message. A conversation is the set of messages between two
/// people — no separate row, since there is nothing to store about it.
model Message {
  id          String    @id @default(uuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  /// A thread, read from either side.
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  /// The unread badge.
  @@index([recipientId, readAt])
}

/// One student blocking another. For messages it works both ways: neither
/// can write to the other until the blocker lifts it. The blocked student is
/// never told — they see the same "not taking new messages" as an opt-out.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// A conversation reported to moderators. Separate from `Report` because
/// what is reported is a person's messages, not a project, and what a
/// moderator can do about it differs (suspend messaging, not take down).
model MessageReport {
  id           String       @id @default(uuid())
  reporterId   String
  reportedId   String
  reason       ReportReason
  details      String?
  /// The recent thread as the reporter saw it when they reported —
  /// `[{ senderId, body, createdAt }]`, oldest first. A snapshot rather than a
  /// live read, so the moderator judges what was reported.
  messages     Json
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  reporter   User  @relation("MessageReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User  @relation("MessageReported", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("MessageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId, status])
}
