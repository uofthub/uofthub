DATABASE_URL="postgresql://uofthub:uofthub@localhost:5432/uofthub"
JWT_SECRET="change-me-in-production"
PORT=3001

# Microsoft Entra ID (Azure AD) OAuth
# Azure Portal → App registrations → your app → Overview
MICROSOFT_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_CLIENT_SECRET="your-client-secret-value"
MICROSOFT_REDIRECT_URI="http://localhost:3001/auth/callback"

# Authority segment, NOT necessarily your own tenant's GUID.
#   organizations - any work/school tenant (required to accept utoronto.ca
#                   accounts; the app registration must also be set to
#                   "Accounts in any organizational directory")
#   <tenant guid> - only users homed in that one tenant
# Defaults to "organizations" when unset.
MICROSOFT_TENANT_ID="organizations"

WEB_URL="http://localhost:5173"

# This API's own public base URL — used to build stable links back to it,
# e.g. GET /users/:id/avatar (see apps/api/src/lib/avatar.ts). Change this to
# the real API domain in production.
API_URL="http://localhost:3001"

# Cloudflare R2 (S3-compatible). Create the bucket and an R2 API token in the
# Cloudflare dashboard → R2 → Manage R2 API Tokens.
STORAGE_BUCKET="uofthub-files"
STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY="<R2_ACCESS_KEY_ID>"
STORAGE_SECRET_KEY="<R2_SECRET_ACCESS_KEY>"
