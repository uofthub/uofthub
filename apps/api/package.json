{
  "name": "@uofthub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma migrate deploy && prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "grant-admin": "tsx src/scripts/grantAdmin.ts",
    "sweep-orgs": "tsx src/scripts/sweepOrgs.ts",
    "grant-term-storage": "tsx src/scripts/grantTermStorage.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/oauth2": "^8.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^5.20.0",
    "@uofthub/types": "workspace:*",
    "fastify": "^5.0.0",
    "file-type": "^22.0.2",
    "resend": "^6.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.11"
  }
}
