generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  UOFT
  PUBLIC
}

enum CollaboratorRole {
  OWNER
  COLLABORATOR
  VIEWER
}

/// The three U of T campuses. Nullable wherever it appears: campus was added
/// after launch so existing rows have none, and nothing obliges a student to
/// say which one they are at.
enum Campus {
  UTSG
  UTM
  UTSC
}

enum OrgType {
  CLUB
  LAB
}

/// Verification lifecycle for a student group — see docs/student-groups.md.
/// A group is invisible to everyone but its own members until VERIFIED.
enum OrgStatus {
  PENDING_VERIFICATION
  IN_REVIEW
  INFO_REQUESTED
  VERIFIED
}

/// The first five are administrative — something happened that the student has
/// to answer or is obliged to know. The rest are social: somebody engaged with
/// their work, or somebody they follow published. Without those the site asks
/// students to publish into a void, since a like or a comment was previously
/// only discoverable by reopening the project and reading a counter.
enum NotificationType {
  COLLABORATOR_INVITED
  COLLABORATOR_RESPONDED
  ACCESS_REQUESTED
  ACCESS_REQUEST_DECIDED
  PROJECT_MODERATED
  PROJECT_LIKED
  PROJECT_COMMENTED
  PROJECT_FORKED
  PROJECT_REACTED
  FOLLOWED_YOU
  FOLLOWING_PUBLISHED
}

/// Low-friction feedback on a project, deliberately not a popularity score:
/// a blank comment box on a stranger's capstone collects nothing, where one
/// tap saying what specifically worked costs the reader almost nothing.
enum ReactionKind {
  USEFUL
  IMPRESSIVE
  WELL_DOCUMENTED
  WOULD_USE
}

enum ReportReason {
  SPAM
  HARASSMENT
  ACADEMIC_INTEGRITY
  INTELLECTUAL_PROPERTY
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  WARNED
  TAKEN_DOWN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  /// scrypt hash; null for accounts that only ever signed in with Microsoft.
  passwordHash String?
  faculty   String?
  campus    Campus?
  program   String?
  classYear Int?
  avatarUrl String?
  /// R2 object key when the avatar lives in our bucket; null for no avatar or
  /// an externally-pasted URL. Fixed per user (`avatars/<id>`) — a new
  /// upload/sync always overwrites the previous one.
  avatarKey String?
  /// True once the student has set their own avatar (upload or manual URL) —
  /// the Microsoft sign-in avatar sync only ever fires for a brand new
  /// account, so it never overwrites this.
  avatarIsCustom Boolean  @default(false)
  bio       String?
  /// Platform moderator. Set directly in the database (see
  /// `pnpm --filter @uofthub/api grant-admin <email>`) — nothing in the app
  /// grants it, so it can't be escalated to through the API.
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects  Project[]             @relation("ProjectOwner")
  collaborations ProjectCollaborator[]
  likes          ProjectLike[]
  reactions      ProjectReaction[]
  comments       Comment[]
  following      Follow[]              @relation("Following")
  followers      Follow[]              @relation("Followers")
  orgMemberships OrgMember[]
  notifications  Notification[]
  reportsFiled   Report[]              @relation("Reporter")
  reportsReviewed Report[]             @relation("Reviewer")
  orgActivities  OrgActivity[]
}

model Project {
  id           String     @id @default(uuid())
  ownerId      String
  title        String
  description  String?
  tags         String[]   @default([])
  visibility   Visibility @default(PRIVATE)
  viewCount    Int        @default(0)
  forkedFromId String?
  /// When the project first stopped being PRIVATE. Distinct from createdAt: a
  /// capstone drafted in January and published in March belongs in March's
  /// feed, not January's. Null while it has never been visible to anyone but
  /// the owner, which is also what stops the follower fan-out firing twice on
  /// a project that is toggled UOFT → PRIVATE → UOFT.
  publishedAt  DateTime?
  /// Set while the owner has pinned this to the top of their profile. Pinned
  /// projects are the only ones a profile renders as cards — see
  /// docs/feed-and-density.md for why everything else is a list.
  pinnedAt     DateTime?
  /// Set when a moderator takes the project down: visibility is forced back to
  /// PRIVATE and the owner cannot re-open it while this is set. Null for every
  /// project that has never been actioned.
  takenDownAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// Postgres-generated tsvector over title, tags and description — see the
  /// `add_search_and_indexes` migration for the expression. Declared
  /// `Unsupported` because Prisma has no tsvector type: nothing reads it
  /// through the client, only `lib/search.ts` via raw SQL.
  searchVector Unsupported("tsvector")?

  owner         User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  collaborators ProjectCollaborator[]
  files         ProjectFile[]
  links         ProjectLink[]
  likes         ProjectLike[]
  reactions     ProjectReaction[]
  comments      Comment[]
  versions      ProjectVersion[]
  dailyViews    ProjectDailyView[]
  orgProjects   OrgProject[]
  reports       Report[]
  forkedFrom    Project?              @relation("ProjectForks", fields: [forkedFromId], references: [id])
  forks         Project[]             @relation("ProjectForks")

  /// The directory's default read: visible projects, newest first.
  @@index([visibility, createdAt])
  /// A profile's project list, and the owner check in visibleProjectWhere.
  @@index([ownerId, createdAt])
  /// The "trending" sort.
  @@index([viewCount])
  /// The home feed's ordering — see routes/feed.ts.
  @@index([publishedAt])
  /// A profile's pinned strip: six rows out of however many the student owns.
  @@index([ownerId, pinnedAt])
  @@index([searchVector], type: Gin)
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  projectId  String
  reason     ReportReason
  /// Optional free text from the reporter — the reason enum is what the queue
  /// sorts on, this is the context a moderator actually needs to decide.
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  /// Set together when a moderator decides the report.
  reviewedAt DateTime?
  reviewedById String?
  reviewNote String?

  reporter   User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("Reviewer", fields: [reviewedById], references: [id])
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  versionNum  Int
  title       String
  description String?
  tags        String[]  @default([])
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNum])
}

model ProjectDailyView {
  projectId String
  date      DateTime @db.Date
  count     Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date])
  @@index([projectId, date])
}

model ProjectCollaborator {
  projectId String
  userId    String
  role      CollaboratorRole @default(COLLABORATOR)
  accepted  Boolean          @default(false)
  invitedAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])

  /// visibleProjectWhere runs `collaborators.some({ userId })` on every list
  /// query; the @@id above leads with projectId and cannot serve it.
  @@index([userId])
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  /// The group this file's bytes are billed to, stamped at upload time rather
  /// than derived from the project's org links: those links can change later,
  /// and quota already spent must not silently move between accounts. Null
  /// means it counts against the uploader's personal quota.
  orgId      String?
  name       String
  /// R2 object key, not a public URL — downloads go through a signed URL so
  /// they still honour project visibility.
  storageKey String
  sizeBytes  Int
  mimeType   String?
  uploadedAt DateTime @default(now())

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  org     Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  /// Cover lookups, per-project file lists and the file-count cap.
  @@index([projectId])
  /// Per-group storage usage aggregates.
  @@index([orgId])
}

model ProjectLink {
  id        String @id @default(uuid())
  projectId String
  label     String
  url       String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectLike {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

/// One reaction of one kind by one person. Separate rows rather than a single
/// row with flags, so a student can say a project is both useful and well
/// documented without the two answers overwriting each other.
model ProjectReaction {
  projectId String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Leads with projectId, which is what the per-project tally groups by — no
  /// secondary index is needed on top of it.
  @@id([projectId, userId, kind])
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])

  /// Follower counts read by followingId — the @@id leads with followerId.
  @@index([followingId])
}

model Organization {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  type        OrgType   @default(CLUB)
  /// The campus the group is based at. A club can serve all three, which is
  /// what null means here — not "unknown".
  campus      Campus?
  description String?
  websiteUrl  String?
  /// Invite link to the group's Discord server. Validated as a discord.gg /
  /// discord.com URL, not just any http(s) one.
  discordUrl  String?
  /// Share link to the group's GroupMe. Same treatment as discordUrl.
  groupMeUrl  String?
  status      OrgStatus @default(PENDING_VERIFICATION)
  /// Where the verification decision is sent. Required at creation — the
  /// roadmap scoped this as one freeform `contactInfo` field, but a decision
  /// email needs a real address, so the address and the claimed role are
  /// separate columns. Nullable because groups created before verification
  /// existed have neither.
  contactEmail String?
  /// The role the creator claims to hold, e.g. "president", "lab manager".
  contactRole  String?
  /// Auto-delete date while PENDING_VERIFICATION or INFO_REQUESTED; cleared
  /// once material is submitted, since review has no deadline on the student.
  verificationDeadline DateTime?
  /// The creator's most recent verification submission.
  verificationNote     String?
  /// The admin's note back — what was missing, or why it was denied.
  reviewNote           String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  members       OrgMember[]
  projects      OrgProject[]
  activities    OrgActivity[]
  storageGrants OrgStorageGrant[]
  files         ProjectFile[]
}

/// One row per academic term per group: the 10GB allowance granted for that
/// term. Allowances stack — a group's quota is the sum of every grant it has
/// ever received, and nothing is reclaimed when a term rolls over.
model OrgStorageGrant {
  orgId     String
  /// Academic term key, e.g. `2026F` — see lib/terms.ts.
  term      String
  bytes     BigInt
  grantedAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, term])
}

/// A meeting, event, workshop or recap — lighter than a Project, and only
/// ever rendered on the group's own page.
model OrgActivity {
  id          String   @id @default(uuid())
  orgId       String
  createdById String
  title       String
  description String?
  date        DateTime
  link        String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User         @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([orgId, date])
}

model OrgMember {
  orgId  String
  userId String
  role   String @default("MEMBER")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  /// Denormalized display data (project title, actor name, etc.) captured at
  /// creation time, so the feed still reads correctly after the source row
  /// changes or is deleted.
  payload   Json
  /// Identity of the thing being announced, for the notifications that must
  /// only ever fire once — `like:<projectId>:<actorId>`, `follow:<actorId>`.
  /// Without it, un-liking and re-liking a project is an unlimited way to ping
  /// its owner. Null for the announcements that are genuinely new every time
  /// (each comment, each fork).
  key       String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  /// The `notifyOnce` existence check.
  @@index([userId, type, key])
}

model OrgProject {
  orgId     String
  projectId String

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([orgId, projectId])
}
