generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PRIVATE
  UOFT
  PUBLIC
}

enum CollaboratorRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum OrgType {
  CLUB
  LAB
}

enum NotificationType {
  COLLABORATOR_INVITED
  COLLABORATOR_RESPONDED
  ACCESS_REQUESTED
  ACCESS_REQUEST_DECIDED
  PROJECT_MODERATED
}

enum ReportReason {
  SPAM
  HARASSMENT
  ACADEMIC_INTEGRITY
  INTELLECTUAL_PROPERTY
  PRIVACY
  OTHER
}

enum ReportStatus {
  OPEN
  DISMISSED
  WARNED
  TAKEN_DOWN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  /// scrypt hash; null for accounts that only ever signed in with Microsoft.
  passwordHash String?
  faculty   String?
  program   String?
  classYear Int?
  avatarUrl String?
  /// R2 object key when the avatar lives in our bucket; null for no avatar or
  /// an externally-pasted URL. Fixed per user (`avatars/<id>`) — a new
  /// upload/sync always overwrites the previous one.
  avatarKey String?
  /// True once the student has set their own avatar (upload or manual URL) —
  /// the Microsoft sign-in avatar sync only ever fires for a brand new
  /// account, so it never overwrites this.
  avatarIsCustom Boolean  @default(false)
  bio       String?
  /// Platform moderator. Set directly in the database (see
  /// `pnpm --filter @uofthub/api grant-admin <email>`) — nothing in the app
  /// grants it, so it can't be escalated to through the API.
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects  Project[]             @relation("ProjectOwner")
  collaborations ProjectCollaborator[]
  likes          ProjectLike[]
  comments       Comment[]
  following      Follow[]              @relation("Following")
  followers      Follow[]              @relation("Followers")
  orgMemberships OrgMember[]
  notifications  Notification[]
  reportsFiled   Report[]              @relation("Reporter")
  reportsReviewed Report[]             @relation("Reviewer")
}

model Project {
  id           String     @id @default(uuid())
  ownerId      String
  title        String
  description  String?
  tags         String[]
  visibility   Visibility @default(PRIVATE)
  viewCount    Int        @default(0)
  forkedFromId String?
  /// Set when a moderator takes the project down: visibility is forced back to
  /// PRIVATE and the owner cannot re-open it while this is set. Null for every
  /// project that has never been actioned.
  takenDownAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner         User                  @relation("ProjectOwner", fields: [ownerId], references: [id])
  collaborators ProjectCollaborator[]
  files         ProjectFile[]
  links         ProjectLink[]
  likes         ProjectLike[]
  comments      Comment[]
  versions      ProjectVersion[]
  dailyViews    ProjectDailyView[]
  orgProjects   OrgProject[]
  reports       Report[]
  forkedFrom    Project?              @relation("ProjectForks", fields: [forkedFromId], references: [id])
  forks         Project[]             @relation("ProjectForks")
}

model Report {
  id         String       @id @default(uuid())
  reporterId String
  projectId  String
  reason     ReportReason
  /// Optional free text from the reporter — the reason enum is what the queue
  /// sorts on, this is the context a moderator actually needs to decide.
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  /// Set together when a moderator decides the report.
  reviewedAt DateTime?
  reviewedById String?
  reviewNote String?

  reporter   User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?   @relation("Reviewer", fields: [reviewedById], references: [id])
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  versionNum  Int
  title       String
  description String?
  tags        String[]
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNum])
}

model ProjectDailyView {
  projectId String
  date      DateTime @db.Date
  count     Int      @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, date])
  @@index([projectId, date])
}

model ProjectCollaborator {
  projectId String
  userId    String
  role      CollaboratorRole @default(COLLABORATOR)
  accepted  Boolean          @default(false)
  invitedAt DateTime         @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  /// R2 object key, not a public URL — downloads go through a signed URL so
  /// they still honour project visibility.
  storageKey String
  sizeBytes  Int
  mimeType   String?
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectLink {
  id        String @id @default(uuid())
  projectId String
  label     String
  url       String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectLike {
  projectId String
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Organization {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  type        OrgType  @default(CLUB)
  description String?
  websiteUrl  String?
  createdAt   DateTime @default(now())

  members  OrgMember[]
  projects OrgProject[]
}

model OrgMember {
  orgId  String
  userId String
  role   String @default("MEMBER")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  /// Denormalized display data (project title, actor name, etc.) captured at
  /// creation time, so the feed still reads correctly after the source row
  /// changes or is deleted.
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model OrgProject {
  orgId     String
  projectId String

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([orgId, projectId])
}
